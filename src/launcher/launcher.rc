/* The launcher's resources: settings window, version information, and the game's own icon
 * (taken from the player's WINRACE.EXE by dropin-build) */
#include <windows.h>
#include "resource.h"
#include "version.h"

IDI_APP ICON "launcher.ico"

/* 324x262 dialog units: about 486x426 pixels with its 8-point font at 96 dpi, so it fits a
 * 640x480 screen (director, 2026-11-10). On Windows 95, 98 and ME, with fewer settings, it's
 * shorter (launcher.c, fit_window). The settings are on seven tabs (director, 2026-11-15;
 * Video split into Display and Renderer on 2026-11-16): one dialog, its controls shown and
 * hidden by tab (launcher.c, show_page). The tab control comes last, at the bottom of the
 * z-order, so the clicks reach the controls drawn over it; WS_CLIPSIBLINGS stops it painting
 * over them.
 *
 * The layout's rules (2026-11-22, the director: "they're all a bit inconsistent"): groups
 * from x 12 to 312, 4 units apart; side by side, 156 and 138 wide, 6 apart, as tall as each
 * other; rows 14 units apart, the first 12 below the group's top, labels 2 below their row;
 * a group is 30 units tall for one row, 14 more for each row after; a group's second column
 * starts at x 180, under the right-hand group's. Each tab shows its groups as the layout
 * functions in launcher.c place them for the renderer and the Windows version. */
IDD_SETTINGS DIALOG 0, 0, 324, 262
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
CAPTION "Big Red Launcher"
FONT 8, "MS Sans Serif"
BEGIN
    /* General (on Windows 95, 98 and ME without Modern defaults: launcher.c, settings_proc) */
    LTEXT           "", IDC_TITLE, 14, 26, 296, 10
    LTEXT           "ctrl-alt-rees.com", IDC_PAGE_GENERAL, 14, 37, 296, 8
    LTEXT           "A small utility to patch and launch the original Windows version of Big Red Racing (Big Red Software, 1996) on Windows 95 onwards, and on Linux through Wine / Proton.", IDC_PAGE_GENERAL, 14, 52, 296, 16
    LTEXT           "Choose your settings on these tabs, then press Play. Hover over a setting for a one-line reminder; Help (or F1) explains every setting.", IDC_PAGE_GENERAL, 14, 72, 296, 16
    GROUPBOX        "Defaults for your PC", IDC_DEFAULTS_GROUP, 12, 94, 300, 84
    PUSHBUTTON      "Period defaults", IDC_PERIOD, 18, 108, 64, 14, WS_TABSTOP
    LTEXT           "For a 1990s PC with Windows 95, 98 or ME: full screen at the game's low resolution (320x200), drawn as the 1996 game drew it.", IDC_PAGE_GENERAL, 88, 107, 218, 24
    PUSHBUTTON      "Modern defaults", IDC_MODERN, 18, 136, 64, 14, WS_TABSTOP
    LTEXT           "For today's Windows, Linux and Steam Deck: full screen, races at your screen's resolution and drawn as far as the engine allows, sharp and in full colour by the Modern renderer, with modern pads.", IDC_MODERN_TEXT, 88, 135, 218, 24
    LTEXT           "Each sets every setting; press Save or Play to keep them.", IDC_DEFAULTS_NOTE, 18, 164, 288, 8

    /* Display (launcher.c, layout_display, shows each renderer's rows and moves the rows below
     * them) */
    GROUPBOX        "Display", IDC_DISPLAY_GROUP, 12, 24, 156, 142
    LTEXT           "&Renderer:", IDC_RENDERER_LABEL, 18, 38, 54, 8
    COMBOBOX        IDC_RENDERER, 74, 36, 88, 60, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT           "&Mode:", IDC_MODE_LABEL, 18, 52, 54, 8
    COMBOBOX        IDC_MODE, 74, 50, 88, 60, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT           "Resolutio&n:", IDC_RESOLUTION_LABEL, 18, 66, 54, 8
    COMBOBOX        IDC_RESOLUTION, 74, 64, 88, 60, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT           "Ma&x limit:", IDC_MAXLIMIT_LABEL, 18, 80, 54, 8
    COMBOBOX        IDC_MAXLIMIT, 74, 78, 88, 80, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    AUTOCHECKBOX    "Na&tive widescreen", IDC_WIDESCREEN, 18, 92, 144, 10, WS_TABSTOP
    LTEXT           "Scaling &aspect:", IDC_ASPECT_LABEL, 18, 108, 54, 8
    COMBOBOX        IDC_ASPECT, 74, 106, 88, 60, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT           "Scalin&g:", IDC_PRESET_LABEL, 18, 122, 54, 8
    COMBOBOX        IDC_PRESET, 74, 120, 88, 80, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT           "&Window size:", IDC_SCALE_LABEL, 18, 136, 54, 8
    COMBOBOX        IDC_SCALE, 74, 134, 88, 90, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT           "&Colour depth:", IDC_COLOUR_LABEL, 18, 150, 54, 8
    COMBOBOX        IDC_COLOUR, 74, 148, 88, 60, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL

    GROUPBOX        "Frame rate", IDC_PAGE_DISPLAY, 174, 24, 138, 44
    LTEXT           "&Framerate cap:", IDC_PAGE_DISPLAY, 180, 38, 56, 8
    COMBOBOX        IDC_FRAMES, 238, 36, 68, 90, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    AUTOCHECKBOX    "&Vsync", IDC_VSYNC, 180, 50, 126, 10, WS_TABSTOP

    /* Renderer (launcher.c, layout_renderer: the Modern renderer's groups, or with the Original
     * just Smoothness and Miscellaneous) */
    GROUPBOX        "Smoothness", IDC_PAGE_RENDERER, 12, 24, 156, 44
    AUTOCHECKBOX    "&Interpolation (smooth motion)", IDC_INTERP, 18, 36, 144, 10, WS_TABSTOP
    LTEXT           "Camera smoot&hing:", IDC_PAGE_RENDERER, 18, 52, 60, 8
    COMBOBOX        IDC_SMOOTHING, 80, 50, 82, 70, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    GROUPBOX        "Full colour", IDC_GRADIENT_GROUP, 174, 24, 138, 44
    AUTOCHECKBOX    "Smoother sk&y gradients", IDC_SMOOTH_SKY, 180, 36, 126, 10, WS_TABSTOP
    AUTOCHECKBOX    "Smoother game &object gradients", IDC_SMOOTH_SHADING, 180, 50, 126, 10, WS_TABSTOP
    GROUPBOX        "Race world", IDC_WORLD_GROUP, 12, 72, 300, 44
    LTEXT           "&Draw distance:", IDC_DRAWDIST_LABEL, 18, 86, 48, 8
    COMBOBOX        IDC_DRAWDIST, 68, 84, 94, 60, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT           "&Textures:", IDC_TEXTURES_LABEL, 18, 100, 48, 8
    COMBOBOX        IDC_TEXTURES, 68, 98, 94, 60, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT           "O&bject lighting:", IDC_LIGHTING_LABEL, 180, 86, 50, 8
    COMBOBOX        IDC_LIGHTING, 232, 84, 74, 60, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT           "Ob&ject detail:", IDC_DETAIL_LABEL, 180, 100, 50, 8
    COMBOBOX        IDC_DETAIL, 232, 98, 74, 60, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    GROUPBOX        "Miscellaneous", IDC_MISC_GROUP, 12, 120, 300, 44
    AUTOCHECKBOX    "Colour &animation (bugfix)", IDC_COLOUR_ANIM, 18, 132, 144, 10, WS_TABSTOP
    AUTOCHECKBOX    "4:3 H&UD correction", IDC_HUD43, 180, 132, 126, 10, WS_TABSTOP
    LTEXT           "HUD si&ze:", IDC_HUDSIZE_LABEL, 18, 148, 40, 8
    COMBOBOX        IDC_HUDSIZE, 62, 146, 100, 60, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    AUTOCHECKBOX    "Widescreen &menu backgrounds", IDC_WIDEMENUS, 180, 146, 126, 10, WS_TABSTOP
    GROUPBOX        "Engine fixes", IDC_FIXES_GROUP, 12, 168, 300, 44
    AUTOCHECKBOX    "Steady &ground textures", IDC_GROUND_PERSP, 18, 180, 144, 10, WS_TABSTOP
    AUTOCHECKBOX    "Better draw ord&er", IDC_SORT_FOOT, 180, 180, 126, 10, WS_TABSTOP
    AUTOCHECKBOX    "&Close gaps between polygons", IDC_CLOSE_GAPS, 18, 194, 144, 10, WS_TABSTOP
    AUTOCHECKBOX    "Horizo&n culling (experimental)", IDC_HORIZON, 180, 194, 126, 10, WS_TABSTOP

    /* Audio */
    GROUPBOX        "Music", IDC_PAGE_AUDIO, 12, 24, 300, 72
    AUTOCHECKBOX    "CD &music from ripped tracks", IDC_MUSIC, 18, 36, 200, 10, WS_TABSTOP
    LTEXT           "V&olume:", IDC_VOLUME_LABEL, 18, 52, 40, 8
    COMBOBOX        IDC_VOLUME, 62, 50, 50, 90, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT           "Folder:", IDC_FOLDER_LABEL, 18, 66, 40, 8
    EDITTEXT        IDC_FOLDER, 62, 64, 198, 12, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Browse...", IDC_BROWSE, 264, 63, 42, 14, WS_TABSTOP
    LTEXT           "", IDC_TRACKS, 62, 80, 244, 8
    GROUPBOX        "Sound effects", IDC_SFX_GROUP, 12, 100, 300, 44
    AUTOCHECKBOX    "Distant vehicles &quieter (bugfix)", IDC_DISTANCE_VOL, 18, 112, 144, 10, WS_TABSTOP
    AUTOCHECKBOX    "&Stereo fix (bugfix)", IDC_STEREO_PAN, 18, 126, 144, 10, WS_TABSTOP
    LTEXT           "Sound &channels:", IDC_CHANNELS_LABEL, 180, 114, 56, 8
    COMBOBOX        IDC_CHANNELS, 238, 112, 50, 60, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL

    /* Controller (on Windows 95, 98 and ME a note instead of the pad's settings, and the Menus
     * group under it: launcher.c, settings_proc) */
    GROUPBOX        "Controller", IDC_PAD_GROUP, 12, 24, 300, 72
    AUTOCHECKBOX    "Modern &pad (XInput)", IDC_PAD, 18, 36, 120, 10, WS_TABSTOP
    PUSHBUTTON      "Configure...", IDC_JOYCPL, 256, 35, 50, 14, WS_TABSTOP
    LTEXT           "&Deadzone:", IDC_PAD_L1, 18, 52, 44, 8
    COMBOBOX        IDC_DEADZONE, 64, 50, 50, 90, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT           "Sensiti&vity:", IDC_PAD_L2, 18, 66, 44, 8
    COMBOBOX        IDC_SENSITIVITY, 64, 64, 50, 90, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    LTEXT           "Layo&ut:", IDC_PAD_L3, 18, 80, 44, 8
    COMBOBOX        IDC_LAYOUT, 64, 78, 70, 60, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    GROUPBOX        "Vibration", IDC_VIB_GROUP, 12, 100, 300, 58
    AUTOCHECKBOX    "Enable vehicle damage vibration", IDC_VIBRATION, 18, 112, 200, 10, WS_TABSTOP
    AUTOCHECKBOX    "Enable nitro boost vibration", IDC_NITRO_RUMBLE, 18, 126, 200, 10, WS_TABSTOP
    LTEXT           "Intensity:", IDC_INTENSITY_LABEL, 18, 142, 44, 8
    COMBOBOX        IDC_INTENSITY, 64, 140, 50, 90, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    GROUPBOX        "Menus", IDC_MENU_GROUP, 12, 162, 300, 44
    AUTOCHECKBOX    "Controller / keyboard &navigation", IDC_MENU_NAV, 18, 174, 200, 10, WS_TABSTOP
    LTEXT           "Menu &animations:", IDC_MENU_ANIM_LABEL, 18, 190, 60, 8
    COMBOBOX        IDC_MENU_ANIM, 80, 188, 70, 60, CBS_DROPDOWNLIST | WS_TABSTOP
    AUTOCHECKBOX    "Disable animated &titles", IDC_MENU_TITLES, 162, 189, 140, 10, WS_TABSTOP
    LTEXT           "Modern pads (XInput) need a newer version of Windows. Configure opens Windows' own joystick settings; choose the joystick in the game's controls menu.", IDC_PAD_NOTE, 18, 36, 230, 24

    /* Advanced */
    GROUPBOX        "Game", IDC_PAGE_ADVANCED, 12, 24, 300, 30
    LTEXT           "L&anguage:", IDC_PAGE_ADVANCED, 18, 38, 44, 8
    COMBOBOX        IDC_LANGUAGE, 64, 36, 90, 90, CBS_DROPDOWNLIST | WS_TABSTOP | WS_VSCROLL
    GROUPBOX        "Clock", IDC_PAGE_ADVANCED, 12, 58, 300, 44
    LTEXT           "&Tick rate:", IDC_PAGE_ADVANCED, 18, 72, 44, 8
    COMBOBOX        IDC_RATE, 64, 70, 100, 50, CBS_DROPDOWNLIST | WS_TABSTOP
    LTEXT           "&Catch-up:", IDC_PAGE_ADVANCED, 18, 86, 44, 8
    COMBOBOX        IDC_CAP, 64, 84, 64, 50, CBS_DROPDOWNLIST | WS_TABSTOP
    GROUPBOX        "Troubleshooting", IDC_PAGE_ADVANCED, 12, 106, 300, 30
    AUTOCHECKBOX    "Lo&g (writes BRRFIX.LOG next to the launcher)", IDC_LOG, 18, 118, 200, 10, WS_TABSTOP

    /* Updates */
    GROUPBOX        "This version", IDC_PAGE_UPDATES, 12, 24, 300, 30
    LTEXT           "", IDC_VERSION, 18, 38, 288, 8
    GROUPBOX        "New versions", IDC_PAGE_UPDATES, 12, 58, 300, 44
    LTEXT           "New versions of Big Red Launcher and the DOS patch are published on GitHub.", IDC_PAGE_UPDATES, 18, 72, 288, 8
    PUSHBUTTON      "Open the &Releases page", IDC_RELEASES, 18, 83, 100, 14, WS_TABSTOP

    /* under the tabs (launcher.c, fit_window, moves them up on Windows 95, 98 and ME) */
    AUTOCHECKBOX    "S&kip this window next time (to see it again, hold Shift while starting, or use -setup)", IDC_SKIP, 8, 224, 310, 10, WS_TABSTOP
    PUSHBUTTON      "Patch the DOS ve&rsion...", IDC_DOSPATCH, 8, 242, 96, 14, WS_TABSTOP
    PUSHBUTTON      "Help", IDC_HELPFILE, 108, 242, 40, 14, WS_TABSTOP
    DEFPUSHBUTTON   "&Play", IDOK, 214, 240, 34, 16, WS_TABSTOP
    PUSHBUTTON      "&Save", IDC_SAVE, 250, 240, 34, 16, WS_TABSTOP
    PUSHBUTTON      "&Quit", IDCANCEL, 286, 240, 32, 16, WS_TABSTOP

    /* at launcher.c's TABS_X and TABS_Y */
    CONTROL         "", IDC_TABS, "SysTabControl32", WS_TABSTOP | WS_CLIPSIBLINGS, 6, 4, 312, 214
END

1 VERSIONINFO
FILEVERSION BRRFIX_VERSION_NUMBERS
PRODUCTVERSION BRRFIX_VERSION_NUMBERS
FILEOS VOS__WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080904E4"
        BEGIN
            VALUE "CompanyName", "ctrl-alt-rees.com\0"
            VALUE "FileDescription", "Big Red Launcher\0"
            VALUE "FileVersion", BRRFIX_VERSION "\0"
            VALUE "Comments", "Big Red Launcher by ctrl-alt-rees. ctrl-alt-rees.com\0"
            VALUE "ProductName", "Big Red Launcher by ctrl-alt-rees\0"
            VALUE "ProductVersion", BRRFIX_VERSION "\0"
            VALUE "InternalName", "Big Red Launcher\0"
            VALUE "OriginalFilename", "Big Red Racing.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0809, 1252
    END
END
