  "KERNEL32.DLL": [
   "GetCommandLineW",
   "GetModuleFileNameW"
  ],
  "note": "Exported by Windows 95 but only as stubs that fail (Unicode); they come from the Open Watcom runtime, which uses the ANSI versions on Windows 9x"
